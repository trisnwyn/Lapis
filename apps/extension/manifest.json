{
  "manifest_version": 3,
  "name": "Lapis — cầu nối LMS",
  "version": "0.2.0",
  "description": "Bắt lịch học từ LMS → đồng bộ thẳng Google Calendar. Dashboard Lapis chỉ là nơi hiển thị.",
  "permissions": ["storage", "identity"],
  "key": "",
  "oauth2": {
    "client_id": "458322241332-joqocs5d506ajj0mbb56jkr167lk8sh0.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar.events"]
  },
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lapis"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/injected.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/lms.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*.vercel.app/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
